{
  "protocol": "E1-decoder-prompt-v1",
  "base_model": "Qwen/Qwen3-VL-2B-Instruct",
  "input": "direct448",
  "feature_layers": [5, 11, 17, 23],
  "decoder_channels": 256,
  "virtual_prompt_tokens": 4,
  "trainable_modules": ["decoder", "prompt_learner"],
  "frozen_modules": ["vision_tower", "language_model", "lm_head"],
  "loss": {
    "classification": "binary Yes/No next-token CE",
    "segmentation": "focal+dice",
    "region": "10-way 3x3+none CE",
    "lambda_seg": 0.2,
    "lambda_region": 0.1
  },
  "sampler": {
    "batch_size": 8,
    "sources": {
      "real_anomaly": 0.25,
      "normal": 0.25,
      "hard_normal": 0.25,
      "pseudo_anomaly": 0.25
    }
  },
  "optimizer": {
    "name": "AdamW",
    "decoder_lr": 0.0001,
    "prompt_lr": 0.0001,
    "weight_decay": 0.01
  },
  "training": {
    "seed": 20260901,
    "logical_batch_size": 8,
    "micro_batch_size": 1,
    "gradient_accumulation": 8,
    "max_steps": 1000,
    "warmup_steps": 50,
    "evaluation_steps": [250, 500, 750, 1000],
    "gradient_clip_norm": 1.0,
    "autocast_dtype": "bfloat16",
    "grad_scaler_enabled": false,
    "grad_scaler_init_scale": 1,
    "mixed_precision": "bfloat16 autocast with BF16 frozen Qwen weights and FP32 trainable parameters/losses; no loss scaling",
    "scheduler": "cosine"
  },
  "checkpoint_metric": "dev-mini macro I-AUPR",
  "stage_gate": {
    "macro_i_aupr_absolute_gain": 0.03,
    "macro_f1max_must_not_drop": true,
    "positive_folds_required": 3,
    "total_folds": 4,
    "small_defect_recall_must_not_drop": true,
    "small_defect_recall_min": 0.9880952381,
    "predicted_mask_threshold": 0.5,
    "ok_view_predicted_area_mean_max": 0.1,
    "overall_view_predicted_area_p95_max": 0.25
  },
  "forbidden": [
    "visual_adapter",
    "llm_lora",
    "holdout_zs_for_selection",
    "pixel_auroc_for_checkpoint_selection"
  ]
}
